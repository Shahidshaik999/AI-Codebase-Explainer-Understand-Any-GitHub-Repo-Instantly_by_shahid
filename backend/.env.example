# LLM Provider: "openai", "gemini", or "grok"
LLM_PROVIDER=grok
LLM_MODEL=grok-3-mini

# API Keys (fill in one)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
GROK_API_KEY=gsk_...

# Embedding model (OpenAI)
EMBEDDING_MODEL=text-embedding-3-small

# Storage paths
CLONE_BASE_DIR=/tmp/ai_explainer_repos
FAISS_INDEX_DIR=/tmp/ai_explainer_faiss

# File processing limits
MAX_FILE_SIZE_KB=100
CHUNK_SIZE_LINES=80
MAX_FILES_PER_REPO=50
