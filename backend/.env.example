# LLM Provider: "meta" | "grok" | "openai" | "gemini"
LLM_PROVIDER=meta
LLM_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# API Keys — fill in the one you use
META_API_KEY=your_meta_llama_api_key_here    # get from https://llama.developer.meta.com
GROK_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# Embedding model (used only with OpenAI provider)
EMBEDDING_MODEL=text-embedding-3-small

# Storage paths
CLONE_BASE_DIR=/tmp/ai_explainer_repos
FAISS_INDEX_DIR=/tmp/ai_explainer_faiss

# File processing limits
MAX_FILE_SIZE_KB=100
CHUNK_SIZE_LINES=80
MAX_FILES_PER_REPO=50
